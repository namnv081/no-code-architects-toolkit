{
  "name": "Subtitle Generation Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-subtitle",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8080/v1/media/transcribe",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-API-Key", 
              "value": "test_api_key_123"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "media_url",
              "value": "={{ $json.video_url }}"
            },
            {
              "name": "task",
              "value": "transcribe"
            },
            {
              "name": "include_text",
              "value": true
            },
            {
              "name": "include_srt", 
              "value": true
            },
            {
              "name": "language",
              "value": "={{ $json.language || 'vi' }}"
            },
            {
              "name": "response_type",
              "value": "direct"
            }
          ]
        },
        "options": {}
      },
      "id": "http-request-node",
      "name": "Get Subtitle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"subtitle\": $json.response.srt, \"text\": $json.response.text } }}"
      },
      "id": "respond-node",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Get Subtitle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Subtitle": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main", 
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1"
